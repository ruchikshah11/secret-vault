<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>SecretVault</AssemblyName>
    <ApplicationIcon>Assets\SecretVault.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\SecretVault.ico" LogicalName="SecretVault.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretVault.Core\SecretVault.Core.csproj" />
  </ItemGroup>

</Project>