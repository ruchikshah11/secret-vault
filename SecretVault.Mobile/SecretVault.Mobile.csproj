<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android app. Building needs the .NET "maui-android" workload, a JDK 17 and the Android SDK. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<!-- The same app also builds for Windows, to run and check the screens on a PC. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<OutputType>Exe</OutputType>
		<RootNamespace>SecretVault.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>SecretVault</ApplicationTitle>
		<ApplicationId>com.secretvault.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 9+: needed for BiometricPrompt-backed Keystore keys and for clearing the clipboard. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>

		<!-- One self-contained .apk that can be installed directly on a phone (no Play Store needed). -->
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>

		<!-- Where install steps in the README put the JDK and Android SDK (no admin rights needed). -->
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\jdk-17')">$(LOCALAPPDATA)\Android\jdk-17</JavaSdkDirectory>

		<!-- CS1591: no XML docs in an app. NU1608: AndroidX.Biometric pins older -ktx helpers than MAUI's AndroidX;
		     same major versions, so the newer ones are used. -->
		<NoWarn>$(NoWarn);CS1591;NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4788" BaseSize="160,160" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SecretVault.Core\SecretVault.Core.csproj" />
		<!-- The vault is JSON read by reflection: never let the release trimmer drop model properties. -->
		<TrimmerRootAssembly Include="SecretVault.Core" />
	</ItemGroup>

</Project>
